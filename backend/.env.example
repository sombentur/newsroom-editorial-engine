# A font with Kannada glyphs for thumbnails. Nirmala UI ships with Windows; on other systems point this at
# Noto Sans Kannada (https://fonts.google.com/noto/specimen/Noto+Sans+Kannada) or another Kannada-capable font.
THUMBNAIL_FONT_PATH=C:/Windows/Fonts/NirmalaB.ttf
