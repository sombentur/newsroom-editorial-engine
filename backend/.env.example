# News Room Editorial Engine — private configuration template.
#
# "Setup Local.cmd" copies this file to backend/.env and fills in MONGO_URL, DB_NAME, APP_URL, CORS_ORIGINS,
# SESSION_SECRET, WP_CREDENTIAL_ENCRYPTION_KEY and the local defaults. Everything else is yours to set.
# backend/.env is ignored by Git. Never paste it, or any key, into chat, issues or screenshots.

# ---- Local runtime (filled in by Setup; leave blank here) ----
MONGO_URL=
DB_NAME=
APP_URL=
CORS_ORIGINS=
SESSION_SECRET=
WP_CREDENTIAL_ENCRYPTION_KEY=
LOCAL_SETUP_ENABLED=false
NODE_ENV=
PORT=
LOG_LEVEL=

# ---- AI providers (enter in Setup Wizard → AI Providers, or here) ----
# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Research must name a Deep Research agent, not a chat model.
GEMINI_RESEARCH_MODEL=
GEMINI_WRITING_MODEL=
# Fast model for scoring discovered topics and for the Chrome Bridge page planner.
GEMINI_FAST_MODEL=gemini-flash-latest
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
# Which provider does what: gemini or openai.
RESEARCH_AI_PROVIDER=gemini
WRITING_AI_PROVIDER=gemini
IMAGE_AI_PROVIDER=openai
# Chrome Bridge page planner (optional): gemini or openai, and model fallbacks when one is overloaded.
BROWSER_CONTROLLER_PROVIDER=gemini
BROWSER_CONTROLLER_MODEL=
BROWSER_CONTROLLER_FALLBACKS=
# Rank Math account API key (optional; Rank Math Content AI features).
RANKMATH_API_KEY=

# ---- Safety switches (safe defaults; change deliberately) ----
# review, research_only or auto
OPERATING_MODE=review
# true = no WordPress writes at all
DRY_RUN=true
# true = automatic publishing cannot be switched on
REPAIR_LOCK=true
# true = the background scheduler runs (also needs the in-app switch)
SCHEDULER_ENABLED=false
# true = finished articles may be published without a click (also needs OPERATING_MODE=auto and the site's Auto switch)
AUTO_PUBLISH_ENABLED=false
# true = subjects flagged as high-risk wait for your approval
HIGH_RISK_REVIEW_REQUIRED=true
# true = AI actions you trigger by hand are allowed while publishing stays locked
MANUAL_AI_ENABLED=false
SOURCE_GROUNDED_RESEARCH_ENABLED=false

# ---- Language and images ----
# true = extra AI language/fact audit for Kannada articles after writing
KANNADA_AI_AUDIT=false
# A font with Kannada glyphs, used when the app renders headline text itself (Windows default shown).
THUMBNAIL_FONT_PATH=C:/Windows/Fonts/NirmalaB.ttf

# ---- Chrome Bridge (optional) ----
# Folder where Chrome loads the unpacked extension from, if the app cannot find it automatically.
BROWSER_EXTENSION_DIR=
